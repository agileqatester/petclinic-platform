aws_region     = "eu-central-1"
environment    = "dev"
aws_account_id = "YOUR_AWS_ACCOUNT_ID"

nat_instance_type = "t4g.micro"

# Do not put my_ip here. Pass it at every plan/apply:
#   -var="my_ip=$(curl -s https://checkip.amazonaws.com)/32"
#
# Do not put openai_api_key here. Empty skips the secret (genai uses demo).
#   TF_VAR_openai_api_key='sk-...' terraform plan ...
#
# Do not set enable_observability here. Default is false (no t4g.large).
# A short Prometheus session only:
#   -var=enable_observability=true
# Apply again without that flag to delete the node.
